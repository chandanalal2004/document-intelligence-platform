# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider used for AI-based field extraction ---
# Works with any OpenAI-compatible provider. Default here is Groq
# (get a free key at https://console.groq.com/keys).
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Database ---
# Default: local SQLite file. For Postgres/MySQL use a full SQLAlchemy URL, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./storage/app.db

# --- File handling ---
UPLOAD_DIR=./storage/uploads
MAX_PAGE_COUNT=3
MAX_FILE_SIZE_MB=15

# --- OCR heuristic ---
NATIVE_TEXT_MIN_CHARS_PER_PAGE=40

# --- CORS ---
CORS_ORIGINS=*

# --- App ---
ENV=development
LOG_LEVEL=INFO
